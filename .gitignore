# Visual Studio, VSCode 및 Rider 사용자별 파일
.vs/
.idea/
.vscode/
.vsconfig
/Project5090/Content/LargeAssets/
Project5090/.ignore # <- 이건 아직 잘 모르겠어
Project5090.code-workspace
Project5090.sln.DotSettings.user

# 컴파일된 오브젝트 파일
*.slo
*.lo
*.o
*.obj

# 프리컴파일된 헤더
*.gch
*.pch

# 컴파일된 동적 라이브러리
*.so
*.dylib

*.pdb

# Fortran 모듈 파일
*.mod

# 컴파일된 정적 라이브러리
*.lai
*.la
*.a

# 실행 파일
*.exe
*.out
*.app
*.ipa

# 엔진에서 생성될 수 있는 프로젝트 파일
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# 프리컴파일된 에셋
Project5090/SourceArt/**/*.png
Project5090/SourceArt/**/*.tga

# 빌드
Project5090/Build/*

# PakBlacklist-<BuildConfiguration>.txt 파일 화이트리스트
!Project5090/Build/*/
!Project5090/Build/*/**
!Project5090/Build/*/PakBlacklist*.txt

# 빌드에서 아이콘 파일 무시하지 않음
!Project5090/Build/**/*.ico

# 맵용으로 빌드된 데이터. 빌드된 라이트맵을 공유하고 싶으면 이 규칙을 제거해도 돼.
*_BuiltData.uasset

# 에디터에서 생성된 설정 파일
Project5090/Saved/*

# 엔진에서 사용할 컴파일된 소스 파일
Project5090/Intermediate/*
Project5090/Plugins/*/Intermediate/*
Project5090/Plugins/**/Binaries/Win64
Project5090/Binaries/
Project5090/Build/Windows/FileOpenOrder/CookerOpenOrder.log
Project5090/Build/Windows/FileOpenOrder/EditorOpenOrder.log
